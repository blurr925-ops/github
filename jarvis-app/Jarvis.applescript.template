-- JARVIS launcher: starts the local JARVIS helper (if it isn't running) and opens the app window.
-- build.sh fills in the paths below and compiles this with osacompile.
set jarvisDir to "__JARVIS_DIR__"
set nodeBin to "__NODE_BIN__"
set claudeBin to "__CLAUDE_BIN__"
set appURL to "http://127.0.0.1:4777/"
set pingCmd to "/usr/bin/curl -s -o /dev/null --max-time 1 " & appURL

-- 1. Start the helper if it isn't already answering.
set isUp to true
try
	do shell script pingCmd
on error
	set isUp to false
end try
if not isUp then
	do shell script "mkdir -p " & quoted form of (jarvisDir & "/app/data") & " && cd " & quoted form of jarvisDir & " && JARVIS_CLAUDE_BIN=" & quoted form of claudeBin & " nohup " & quoted form of nodeBin & " app/server.js > app/data/server.log 2>&1 &"
	repeat 60 times
		try
			do shell script pingCmd
			set isUp to true
			exit repeat
		end try
		delay 0.25
	end repeat
end if
if not isUp then
	display dialog "JARVIS couldn't start its helper. Details are in app/data/server.log inside the JARVIS folder." buttons {"OK"} default button 1 with icon caution
	return
end if

-- 2. Open the window: an app-style window in Chrome, Edge or Brave if installed, else Safari.
set browsers to {"/Applications/Google Chrome.app", "/Applications/Microsoft Edge.app", "/Applications/Brave Browser.app"}
repeat with b in browsers
	try
		do shell script "test -d " & quoted form of (b as text)
		do shell script "open -na " & quoted form of (b as text) & " --args --app=" & appURL & " --window-size=1320,900"
		return
	end try
end repeat
do shell script "open -a Safari " & appURL
